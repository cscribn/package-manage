<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
Install:
  cp /Users/appfire-chadscribner/projects/package-manage/com.appfire-chadscribner.mac-work-cron.plist ~/Library/LaunchAgents/; \
  launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.appfire-chadscribner.mac-work-cron.plist

  After verifying launchd works, remove the cron entry:
  crontab -l | grep -v mac-work-cron | crontab -

Logs:
  package-manage.log         Workload output (git pull, mac-work.sh, PwshMac.ps1)
  package-manage-launchd.log Bootstrap failures only (empty when healthy)

Test now (kickstart prints nothing on success; watch package-manage.log):
  launchctl kickstart -k gui/$(id -u)/com.appfire-chadscribner.mac-work-cron
  tail -f /Users/appfire-chadscribner/projects/package-manage/package-manage.log

Uninstall:
  launchctl bootout gui/$(id -u)/com.appfire-chadscribner.mac-work-cron
  rm ~/Library/LaunchAgents/com.appfire-chadscribner.mac-work-cron.plist
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.appfire-chadscribner.mac-work-cron</string>

	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/bash</string>
		<string>-c</string>
		<string>date "+%A, %B %d, %Y - %I:%M %p - launchd start" > ./package-manage.log; { git pull; ./mac-work.sh; /usr/local/bin/pwsh ./PwshMac.ps1; } >> ./package-manage.log 2>&amp;1</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/appfire-chadscribner/projects/package-manage</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/appfire-chadscribner</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>USERNAME</key>
		<string>appfire-chadscribner</string>
		<key>SUDO_ASKPASS</key>
		<string>/Users/appfire-chadscribner/.ssh/secrets/.supwd.sh</string>
	</dict>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>

	<key>StandardOutPath</key>
	<string>/Users/appfire-chadscribner/projects/package-manage/package-manage-launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/appfire-chadscribner/projects/package-manage/package-manage-launchd.log</string>

	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
